# Configuration LLM Provider
# Valeurs possibles : gemini | openrouter
LLM_PROVIDER=gemini

# Clé API Google Gemini (gratuit - obtenir sur https://ai.google.dev)
# Requis si LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Clé API OpenRouter (optionnel - obtenir sur https://openrouter.ai)
# Requis si LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
